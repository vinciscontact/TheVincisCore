# TheVincis — site-wide rules (Hostinger, Apache/LiteSpeed)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One home for every page: https://vincisglobal.com (no www), so Google
  # never splits ranking signals between two copies of the site.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # /index.html and /page/index.html are the same pages as / and /page/.
  # Matching THE_REQUEST (what the browser asked for) avoids looping on
  # the server's own internal index.html lookup.
  RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Never serve dot-folders/files (.git, .claude, .gitignore…) except .well-known
  RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
</IfModule>

# Internal docs and database scripts stay private
<FilesMatch "\.(md|sql)$">
  Require all denied
</FilesMatch>
